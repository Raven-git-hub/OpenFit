# Device credentials now live in the UI: Configuration -> Connected
# sources -> Add a device. They're encrypted before they're stored, so
# nothing below is needed for a new install.
#
# The variables in this file are still read as a fallback for installs
# that predate the UI flow, so an existing .env keeps working until you
# re-add the device. .env is only read inside your own container - it
# never leaves your network.

# --- Credential encryption ---
# Optional. Leave unset and OpenFit generates a key at /data/.secret_key
# (0600) on first use. Set it if you'd rather hold the key yourself -
# it must be a urlsafe base64 32-byte Fernet key. Changing or losing the
# key means re-adding your devices in the UI.
# OPENFIT_SECRET_KEY=

# --- Garmin Connect plugin (legacy - prefer the UI) ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Google Health plugin (Pixel Watch / Fitbit) ---
# From a Google Cloud OAuth Client (type: Desktop app). See README for
# the full walkthrough. After creating these, run authorize.py once
# before starting the service - it needs a one-time interactive login
# that the background service can't do on its own.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# How often to auto-sync from all configured plugins, in hours.
SYNC_INTERVAL_HOURS=6

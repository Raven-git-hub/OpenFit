# Copy this file to .env and fill in credentials for whichever plugins
# you're using. .env is only read inside your own container - it never
# leaves your network. Leave a plugin's variables unset if you're not
# using it yet; it'll just show as "not configured" and stay skipped.

# --- Garmin Connect plugin ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Google Health plugin (Pixel Watch / Fitbit) ---
# From a Google Cloud OAuth Client (type: Desktop app). See README for
# the full walkthrough. After creating these, run authorize.py once
# before starting the service - it needs a one-time interactive login
# that the background service can't do on its own.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# How often to auto-sync from all configured plugins, in hours.
SYNC_INTERVAL_HOURS=6
